# ── 基础 ─────────────────────────────────────────────────
ENV=development
DEBUG=False
LOG_LEVEL=INFO

# ── 输出目录 ─────────────────────────────────────────────
OUTPUT_DIR=output
DOUYIN_SAVE_DIR=output/douyin
SOGOU_SAVE_DIR=output/sogou

# ── 抖音 ─────────────────────────────────────────────────
DOUYIN_AUTH_STATE=auth_state.json

# ── 搜狗 ─────────────────────────────────────────────────
SOGOU_DICT_ID=
SOGOU_DICT_URL=


# ── 报警（取消注释启用）─────────────────────────────────
ALERT_ENABLED=false
ALERT_WECHAT_WEBHOOK=
ALERT_EMAIL_SENDER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_RECEIVER=
ALERT_EMAIL_SMTP_TYPE=qq

# ── API ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=5001
API_AUTH_TOKEN=default_secret

# ── 热词 ─────────────────────────────────────────────────
HOT_WORD_GROWTH_THRESHOLD=0.5
JSON_FILE_RETENTION_DAYS=30
